#!/bin/sh

# 1. 환경 변수 설정
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

# 2. 필수 가상 파일 시스템 마운트
# 커널과 소통하고 하드웨어 정보를 얻기 위해 필수적인 가상 디렉터리들을 마운트합니다.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

# 3. mdev 실행 (핫플러그 및 디바이스 노드 자동 생성)
# USB나 SD카드가 꽂혔을 때 /dev 디렉터리에 장치 파일(예: sda1)을 자동으로 만들어줍니다.
echo /sbin/mdev > /proc/sys/kernel/hotplug
mdev -s

# 4. 루프백(Localhost) 네트워크 인터페이스 활성화
# 시스템 내부적인 통신을 위해 127.0.0.1 네트워크를 켭니다.
ifconfig lo up

# 5. 시스템 호스트 이름 설정
# /etc/hostname 파일에 적힌 이름으로 시스템 이름을 지정합니다.
if [ -f /etc/hostname ]; then
    hostname -F /etc/hostname
fi

# 6. 추가 초기화 스크립트 순차 실행 (선택 사항)
# /etc/init.d/ 디렉터리 아래 S로 시작하는 스크립트(S50sshd, S80network 등)가 있다면 차례로 실행합니다.
for script in /etc/init.d/S??*; do
    if [ -x "$script" ]; then
        $script start
    fi
done

