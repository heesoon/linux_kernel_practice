# /etc/inittab

# 1. 시스템 부팅 완료 직후 기초 마운트 스크립트 실행
::sysinit:/etc/init.d/rcS

# 2. C++ 앱을 독립된 백그라운드로 실행 (죽으면 자동으로 다시 살림)
::respawn:/bin/sys_test_app

# 3. 디버그용 콘솔/쉘 실행 (엔터를 치면 진입, exit 치면 이 쉘만 리셋됨)
::askfirst:-/bin/sh

# 4. poweroff 명령어 입력 시 실행할 안전한 전원 차단 절차
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
::shutdown:/sbin/poweroff -f
